# ========== Cloudinary ==========
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=twinklingz

# Hero videos — optional; defaults to Cloudinary URLs in src/data/heroVideos.ts
# VITE_HERO_VIDEO_1=
# VITE_HERO_VIDEO_2=

# ========== Frontend (Vite) ==========
# Public site URL (no trailing slash) — used for canonical URLs, sitemap, Open Graph
VITE_SITE_URL=https://shivanshu.shop

# Web3Forms — paste your access key from https://web3forms.com (no backend needed)
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: custom SMTP API (`npm run server`). If set, it is used instead of Web3Forms.
# Leave blank or comment out to use Web3Forms only.
# VITE_CONTACT_API_URL=http://localhost:3001

# ========== Backend (Node server only — same file can hold both sections) ==========
PORT=3001
CLIENT_ORIGIN=http://localhost:8080

# Inbox that receives contact form submissions (defaults to SMTP_USER if omitted)
CONTACT_TO_EMAIL=shivanshunigam8@gmail.com

# Gmail example — use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
